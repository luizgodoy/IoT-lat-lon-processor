{
  "Geocoding": {
    "Provider": "Nominatim",
    "BaseUrl": "https://nominatim.openstreetmap.org",
    "RequestIntervalMs": 1100,
    "MaxConcurrency": 1,
    "TimeoutSeconds": 30,
    "MaxRetries": 3,
    "CachePrecision": 6,
    "UserAgent": "IoT-lat-lon-processor/1.0 (contact: developer.g2toys@gmail.com)"
  },
  "Processing": {
    "ProgressUpdateIntervalMs": 250,
    "CheckpointEveryRows": 100,
    "KeepInputFiles": true,
    "KeepLogs": true
  }
}