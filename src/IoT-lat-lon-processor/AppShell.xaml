<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="IoT_lat_lon_processor.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:IoT_lat_lon_processor.UI.Views"
    Title="IoT Lat/Lon Processor">

    <TabBar>
        <Tab Title="Início" Route="StartView">
            <ShellContent ContentTemplate="{DataTemplate views:StartView}" />
        </Tab>
        <Tab Title="Histórico" Route="HistoryView">
            <ShellContent ContentTemplate="{DataTemplate views:HistoryView}" />
        </Tab>
        <Tab Title="Configurações" Route="SettingsView">
            <ShellContent ContentTemplate="{DataTemplate views:SettingsView}" />
        </Tab>
    </TabBar>

</Shell>
